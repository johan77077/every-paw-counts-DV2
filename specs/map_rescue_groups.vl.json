{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Pet rescue groups reach every corner of the country",
    "subtitle": "Each dot is one registered pet rescue charity, placed at its postcode",
    "anchor": "start"
  },
  "width": 650,
  "height": 530,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-132, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {"type": "topojson", "feature": "aus_states"}
      },
      "mark": {"type": "geoshape", "fill": "#eeeae3", "stroke": "#ffffff", "strokeWidth": 1.2}
    },
    {
      "data": {
        "url": "data/pet_rescue_groups_points.csv",
        "format": {"parse": {"postcode": "string"}}
      },
      "mark": {"type": "circle", "size": 16, "color": "#6250d6", "opacity": 0.85, "stroke": "#ffffff", "strokeWidth": 0.5},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "tooltip": [
          {"field": "charity_name", "type": "nominal", "title": "Charity"},
          {"field": "town", "type": "nominal", "title": "Town"},
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "volunteers", "type": "quantitative", "title": "Volunteers"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "circle", "size": 40, "color": "#6250d6", "opacity": 0.85},
      "encoding": {"x": {"value": 12}, "y": {"value": 514}}
    },
    {
      "data": {"values": [{"label": "1 dot = 1 pet rescue charity"}]},
      "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 12, "color": "#1f2a24"},
      "encoding": {"x": {"value": 24}, "y": {"value": 514}, "text": {"field": "label"}}
    },
    {
      "data": {
        "values": [
          {"city": "Sydney", "lon": 151.21, "lat": -33.87},
          {"city": "Brisbane", "lon": 153.03, "lat": -27.47},
          {"city": "Hobart", "lon": 147.33, "lat": -42.88}
        ]
      },
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11, "color": "#6b675f"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city"}
      }
    },
    {
      "data": {
        "values": [
          {"city": "Perth", "lon": 115.86, "lat": -31.95},
          {"city": "Adelaide", "lon": 138.6, "lat": -34.93},
          {"city": "Darwin", "lon": 130.84, "lat": -12.46}
        ]
      },
      "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 11, "color": "#6b675f"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city"}
      }
    },
    {
      "data": {"values": [{"city": "Melbourne", "lon": 144.96, "lat": -37.81}]},
      "mark": {"type": "text", "align": "center", "dy": 16, "fontSize": 11, "color": "#6b675f"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city"}
      }
    }
  ]
}
